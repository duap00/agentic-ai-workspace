# ==============================================================================
# Meta Threads API Configuration
# App ID: 2229806474461275 | Business ID: 107558840944600
# ==============================================================================
THREADS_APP_ID=2229806474461275
THREADS_APP_SECRET=your_threads_app_secret_here
THREADS_BUSINESS_ID=107558840944600
THREADS_USE_CASE=THREADS_API

# Threads Account Credentials (Get via Graph API Explorer / Token Generator)
THREADS_USER_ID=your_threads_user_id_here
THREADS_ACCESS_TOKEN=your_threads_long_lived_access_token_here

# All Enabled Threads API Scopes / Permissions (11 Total)
# 1. threads_basic               - Read user's own profile and posts
# 2. threads_content_publish     - Create and publish posts/threads
# 3. threads_delete              - Delete published posts
# 4. threads_keyword_search      - Search content by keyword and reply
# 5. threads_location_tagging    - Search locations & tag media
# 6. threads_manage_insights     - Access profile & post analytics
# 7. threads_manage_mentions     - Monitor and fetch mentions
# 8. threads_manage_replies      - Moderation, hide/unhide, reply controls
# 9. threads_profile_discovery   - Discover public profiles & posts
# 10. threads_read_replies       - Read thread comments & conversation trees
# 11. threads_share_to_instagram - Share Threads posts to linked Instagram
THREADS_SCOPES=threads_basic,threads_content_publish,threads_delete,threads_keyword_search,threads_location_tagging,threads_manage_insights,threads_manage_mentions,threads_manage_replies,threads_profile_discovery,threads_read_replies,threads_share_to_instagram

# Threads Graph API Endpoints
THREADS_API_BASE_URL=https://graph.threads.net/v1.0
THREADS_GRAPH_BASE_URL=https://graph.facebook.com/v21.0

# ==============================================================================
# Google Gemini API (For Marketer & Farmer Agents)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# Telegram Notifications & Alerts
# ==============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
