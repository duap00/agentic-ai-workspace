{
  "name": "KebunData Threads - Two-Tier Auto Responder (Human-Paced)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "kb-reply-0001",
      "name": "Poll Every 10 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [100, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-1",
              "name": "threadsAccessToken",
              "value": "={{ $vars.THREADS_ACCESS_TOKEN || \"\" }}",
              "type": "string"
            },
            {
              "id": "cfg-2",
              "name": "threadsUserId",
              "value": "={{ $vars.THREADS_USER_ID || \"\" }}",
              "type": "string"
            },
            {
              "id": "cfg-3",
              "name": "geminiApiKey",
              "value": "={{ $vars.GEMINI_API_KEY || \"\" }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "kb-reply-0000",
      "name": "Setup Credentials & Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [300, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://graph.threads.net/v1.0/me/threads",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,text,timestamp"
            },
            {
              "name": "limit",
              "value": "5"
            },
            {
              "name": "access_token",
              "value": "={{ $('Setup Credentials & Config').item.json.threadsAccessToken }}"
            }
          ]
        }
      },
      "id": "kb-reply-0002",
      "name": "Fetch Recent Posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "jsCode": "const posts = $input.first().json.data || [];\nreturn posts.map(post => ({\n  json: {\n    postId: post.id,\n    postText: post.text,\n    postTimestamp: post.timestamp\n  }\n}));"
      },
      "id": "kb-reply-0003",
      "name": "Split Posts Array",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.threads.net/v1.0/{{$json.postId}}/replies",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,text,timestamp,username"
            },
            {
              "name": "access_token",
              "value": "={{ $('Setup Credentials & Config').item.json.threadsAccessToken }}"
            }
          ]
        }
      },
      "id": "kb-reply-0004",
      "name": "Fetch Post Replies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\nconst config = $('Setup Credentials & Config').first().json;\n\n// Maintain cache of answered comment IDs to prevent repeat replies\nconst staticData = $getWorkflowStaticData('global');\nstaticData.repliedIds = staticData.repliedIds || [];\n\nfor (const item of items) {\n  const replies = item.json.data || [];\n  const parentPostText = item.pairedItem && $items('Split Posts Array')[item.pairedItem.item] ? $items('Split Posts Array')[item.pairedItem.item].json.postText : '';\n  \n  for (const reply of replies) {\n    // Skip if already processed or authored by self\n    if (staticData.repliedIds.includes(reply.id)) continue;\n    if (reply.username && (reply.username.toLowerCase().includes('kebundata') || reply.username.toLowerCase().includes('ak.kamil'))) continue;\n    \n    // Mark as processed\n    staticData.repliedIds.push(reply.id);\n    if (staticData.repliedIds.length > 500) {\n      staticData.repliedIds.shift();\n    }\n    \n    // Anti-Bot: Random delay between 15 to 45 seconds per reply\n    const jitterSeconds = Math.floor(Math.random() * (45 - 15 + 1)) + 15;\n    \n    results.push({\n      json: {\n        commentId: reply.id,\n        commentText: reply.text,\n        username: reply.username || 'Sahabat Kebun',\n        parentPostText: parentPostText,\n        jitterSeconds: jitterSeconds,\n        userId: config.threadsUserId,\n        accessToken: config.threadsAccessToken\n      }\n    });\n    \n    // Rate pacing: Limit to max 2 replies per batch run to avoid burst spam flags\n    if (results.length >= 2) break;\n  }\n  if (results.length >= 2) break;\n}\n\nreturn results;"
      },
      "id": "kb-reply-0005",
      "name": "Filter New Comments (Anti-Spam Paced)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 300]
    },
    {
      "parameters": {
        "amount": "={{ $json.jitterSeconds || 20 }}",
        "unit": "seconds"
      },
      "id": "kb-reply-0005-jitter",
      "name": "Natural Human Jitter",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1400, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $('Setup Credentials & Config').item.json.geminiApiKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Anda adalah Ahmad Kamil / KebunData (Gabungan Agronomist Pakar + Sahabat Kebun Mesra) di Meta Threads.\\n\\nPost Asal: {{$json.parentPostText}}\\nKomen Daripada @{{$json.username}}: {{$json.commentText}}\\n\\nSyarat Balasan (Human Voice & Anti-Bot):\\n1. NADA: Santai, jujur, mesra macam kawan borak di kebun (Bahasa Melayu santai / Manglish biasa).\\n2. DILARANG SAMA SEKALI guna gaya robotik/formal seperti 'Hai pengguna', 'Sebagai AI', atau templat berulang. Terus masuk respon bersahaja.\\n3. ILMU: Berikan 1 tip agronomi ringkas & logik yang selesaikan keraguan (1-2 ayat).\\n4. CONVERSATION EXTENDER (WAJIB): Di hujung ayat, tanya SATU soalan susulan yang mesra (cth: jenis media tanam, waktu siraman, atau jenis benih) supaya dia rasa teruja nak balas balik.\\n5. PANJANG: 2-3 ayat sahaja.\\n\\nOutputkan teks balasan sahaja tanpa tanda petik.\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0.85,\n    \"maxOutputTokens\": 300\n  }\n}"
      },
      "id": "kb-reply-0006",
      "name": "Generate Reply (Gemini Natural Voice)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1620, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.threads.net/v1.0/me/threads",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "media_type",
              "value": "TEXT"
            },
            {
              "name": "text",
              "value": "={{$json.candidates[0].content.parts[0].text.trim()}}"
            },
            {
              "name": "reply_to_id",
              "value": "={{$node[\"Filter New Comments (Anti-Spam Paced)\"].json[\"commentId\"]}}"
            },
            {
              "name": "access_token",
              "value": "={{ $('Setup Credentials & Config').item.json.threadsAccessToken }}"
            }
          ]
        }
      },
      "id": "kb-reply-0007",
      "name": "Create Reply Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1840, 300]
    },
    {
      "parameters": {
        "amount": 4,
        "unit": "seconds"
      },
      "id": "kb-reply-0008",
      "name": "Wait 4s for Ingestion",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2060, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.threads.net/v1.0/me/threads_publish",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "creation_id",
              "value": "={{$node[\"Create Reply Container\"].json[\"id\"]}}"
            },
            {
              "name": "access_token",
              "value": "={{ $('Setup Credentials & Config').item.json.threadsAccessToken }}"
            }
          ]
        }
      },
      "id": "kb-reply-0009",
      "name": "Publish Reply to Threads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2280, 300]
    }
  ],
