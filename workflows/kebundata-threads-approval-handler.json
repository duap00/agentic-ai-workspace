        "operation": "sendMessage",
        "chatId": "={{ $('Validate Stored Approval').first().json.chatId }}",
        "text": "=✅ <b>Berjaya Dipublish!</b>\nKomen balasan telah dipublish ke Meta Threads untuk @{{ $('Validate Stored Approval').first().json.username }}.\nThreads Reply ID: {{ $('Publish to Threads').first()?.json?.id }}",
        "additionalFields": {
