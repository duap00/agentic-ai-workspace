        "query": "UPDATE public.threads_outbound_logs SET approval_status='REJECTED_BY_HUMAN',publish_status='REJECTED' WHERE id=$1 AND approval_status='PENDING_HUMAN_APPROVAL' AND publish_status='UNPUBLISHED' RETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $('Validate Stored Approval').first().json.approvalId ] }}"
        }
      },
