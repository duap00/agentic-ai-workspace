{
  "name": "KebunData Threads - Human Approval & Publisher Webhook v2",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "threads-approval",
        "options": {},
        "authentication": "headerAuth"
      },
      "id": "e15f4079-37e6-45a0-a05e-4c3a930e0298",
      "name": "Telegram Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -2352,
        4304
      ],
      "webhookId": "threads-approval"
    },
    {
      "parameters": {
        "jsCode": "const raw=$input.first().json;\nconst cb=(raw.body || raw).callback_query;\nconst match=/^(approve|reject)_log_([1-9]\\d*)$/.exec(cb?.data || '');\nconst expectedReviewerId='YOUR_TELEGRAM_REVIEWER_ID';\nconst expectedChatId='YOUR_TELEGRAM_CHAT_ID';\nconst reviewerId=String(cb?.from?.id || '');\nconst chatId=String(cb?.message?.chat?.id || '');\nif (!match || !cb?.id || reviewerId!==expectedReviewerId || chatId!==expectedChatId) return [];\nreturn [{json:{valid:true,action:match[1],approvalId:match[2],reviewerId,chatId,callbackQueryId:cb.id,messageId:cb.message.message_id,config:{threadsUserId:'YOUR_THREADS_USER_ID',telegramChatId:expectedChatId}}}];"
      },
      "id": "25954dc9-6132-4d71-93fc-3664d1bd9067",
      "name": "Parse Telegram Callback Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2144,
        4304
      ]
    },
    {
      "parameters": {
        "resource": "callback",
        "operation": "answerQuery",
        "queryId": "={{ $json.callbackQueryId }}",
        "additionalFields": {
          "text": "={{ $json.action === 'approve' ? '✅ Kelulusan diterima! Memproses balasan Threads...' : '❌ Keputusan ditolak.' }}",
          "show_alert": true
        }
      },
      "id": "86514ac8-4766-4865-bc63-1e3e9a3515d5",
      "name": "Answer Telegram Callback",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        -1952,
        4304
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-valid",
              "leftValue": "={{ $('Parse Telegram Callback Data').first().json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5bf90c27-2b76-434b-b1d2-73e8b4319be0",
      "name": "Is Valid Callback?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -1744,
        4304
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.threads_outbound_logs\nSET approval_status=CASE WHEN $1='approve' THEN 'APPROVAL_CLAIMED' ELSE 'REJECTED_BY_HUMAN' END,\npublish_status=CASE WHEN $1='approve' THEN 'PUBLISHING' ELSE 'REJECTED' END,\napproved_by_telegram_user_id=$2, approval_claimed_at=CURRENT_TIMESTAMP\nWHERE id=$3 AND approval_status='PENDING_HUMAN_APPROVAL' AND publish_status='UNPUBLISHED'\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ [ $('Parse Telegram Callback Data').first().json.action, $('Parse Telegram Callback Data').first().json.reviewerId, $('Parse Telegram Callback Data').first().json.approvalId ] }}"
        }
      },
      "id": "d8b65794-6e66-439d-bb9a-393e0550d0d6",
      "name": "Claim Pending Approval",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        -1552,
        4304
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const cb=$('Parse Telegram Callback Data').first().json;\nconst row=$input.first()?.json || {};\nif (!row.id || String(row.id)!==String(cb.approvalId) || !/^\\d+$/.test(String(row.post_id || '')) || typeof row.draft_reply!=='string' || !row.draft_reply.trim()) throw new Error('Missing or incomplete stored approval');\nconst approved=cb.action==='approve' && row.approval_status==='APPROVAL_CLAIMED' && row.publish_status==='PUBLISHING';\nconst rejected=cb.action==='reject' && row.approval_status==='REJECTED_BY_HUMAN' && row.publish_status==='REJECTED';\nif (!approved && !rejected) throw new Error('Approval has already been used or is not pending');\nreturn [{json:{...cb,approvalId:row.id,post_id:row.post_id,username:row.username,draft_reply:row.draft_reply,matched_topic:row.matched_topic}}];"
      },
      "id": "401c2bf1-ff48-42ee-b78a-1e3e5c2ec25d",
      "name": "Validate Stored Approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1344,
        4304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-action-approve",
              "leftValue": "={{ $json.action }}",
              "rightValue": "approve",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "dc5ecaa8-93f1-48e3-9b0b-e10a3bdf2d0a",
      "name": "Is Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -1152,
        4304
      ]
    },
