        "genericAuthType": "httpQueryAuth"
      },
      "id": "80efcf8b-9eb5-4797-b1ef-63c4b2b3334f",
      "name": "Publish to Threads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -544,
        4192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH updated AS (\nUPDATE public.threads_outbound_logs SET approval_status='APPROVED_BY_HUMAN',publish_status='PUBLISHED',threads_reply_id=$1\nWHERE id=$2 AND approval_status='APPROVAL_CLAIMED' AND publish_status='PUBLISHING'\nRETURNING id,author_id,username,matched_topic\n), author_update AS (\nINSERT INTO public.threads_authors (author_id,username,last_engaged_at,engagement_count,last_topic)\nSELECT COALESCE(author_id,username),username,CURRENT_TIMESTAMP,1,matched_topic FROM updated WHERE username IS NOT NULL\nON CONFLICT (author_id) DO UPDATE SET last_engaged_at=CURRENT_TIMESTAMP,engagement_count=threads_authors.engagement_count+1,last_topic=EXCLUDED.last_topic\nRETURNING author_id\n) SELECT id FROM updated;",
        "options": {
          "queryReplacement": "={{ [ $json.id, $('Validate Stored Approval').first().json.approvalId ] }}"
        }
      },
      "id": "44e11b6d-1534-4a6b-92f8-7789eee93d8f",
      "name": "Update Postgres Approved",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        -352,
        4192
      ]
    },
    {
      "parameters": {
